# Application Settings
APP_NAME="AI-Powered Customer Journey Friction Assistant"
APP_ENV=development
DEBUG=True
API_V1_PREFIX=/api/v1
PORT=8000
HOST=0.0.0.0

# Database Configuration (PostgreSQL with SQLite fallback for instant hackathon dev)
# Default PostgreSQL URL:
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/friction_assistant_db
# SQLite alternative:
# DATABASE_URL=sqlite:///./friction_assistant.db

# CORS Allowed Origins (Comma-separated for React frontend)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:5174,http://127.0.0.1:3000,http://127.0.0.1:5173

# Reserved for Integration Partners (ML & Gemini)
ML_MODEL_VERSION=xgboost_v1.0
GEMINI_API_KEY=
